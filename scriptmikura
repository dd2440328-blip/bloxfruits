RunService.RenderStepped:Connect(function()
    local t = tick()
    local wave = math.sin(t * 3.5)
    local r = 0.7 + 0.3 * wave
    local g = 0.2 - 0.2 * wave
    local b = 0.2 - 0.2 * wave
    if wave > 0 then
        r = 0.7 + 0.3 * wave
        g = 0.2 + 0.8 * wave
        b = 0.2 + 0.8 * wave
    end
    Title.TextColor3 = Color3.new(r, math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end)

