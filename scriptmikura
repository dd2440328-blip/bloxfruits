EditBtn.MouseButton1Click:Connect(function()
    EditFrame.Visible = not EditFrame.Visible
    if EditFrame.Visible then
        MainFrame.Size = UDim2.new(0, 260, 0, 120)
        InputBox.Text = Config.CurrentDon
        InputBox:CaptureFocus()
    else
        MainFrame.Size = UDim2.new(0, 260, 0, 95)
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    local newNote = InputBox.Text
    if newNote == "" then return end

    Config.CurrentDon = newNote
    OrderLabel.Text = "Đơn: " .. Config.CurrentDon

    if Config.UseRAM and RamConnected then
        local successSet = RAM_API("POST", "SetDescription", "Đơn: " .. newNote)
        if successSet then
            SendNotification("Mikura Hub", "Đã cập nhật đơn lên RAM!")
        else
            SendNotification("Lỗi RAM", "Không thể gửi dữ liệu lên RAM.")
        end
    else
        SaveLocalData()
        SendNotification("Mikura Hub", "Đã lưu đơn vào máy (Local)!")
    end
    
    EditFrame.Visible = false
    MainFrame.Size = UDim2.new(0, 260, 0, 95)
end)

ToggleRAMBtn.MouseButton1Click:Connect(function()
    if not RamConnected and not Config.UseRAM then
        SendNotification("Cảnh báo", "RAM chưa kết nối! Vui lòng kiểm tra Log.")
        return
    end

    Config.UseRAM = not Config.UseRAM
    ToggleRAMBtn.Text = Config.UseRAM and "LƯU TRÊN: RAM API" or "LƯU TRÊN: MÁY LOCAL"
    ToggleRAMBtn.BackgroundColor3 = Config.UseRAM and Color3.fromRGB(25, 100, 25) or Color3.fromRGB(140, 20, 20)
    SendNotification("Trạng thái", Config.UseRAM and "Đã bật RAM API!" or "Đã tắt RAM, chuyển sang lưu Local.")
end)

